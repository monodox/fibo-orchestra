# Backend environment variables
FRONTEND_ORIGINS=http://localhost:3000

# API Keys (get from Integrations page in frontend)
# Get your keys from:
# - Bria: https://bria.ai (Recommended for FIBO features)
# - Replicate: https://replicate.com/account/api-tokens
# - FAL.ai: https://fal.ai/dashboard/keys
# - Runware: https://runware.ai
BRIA_API_KEY=
REPLICATE_API_TOKEN=
FAL_API_KEY=
RUNWARE_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (set USE_S3=true to enable S3/MinIO)
USE_S3=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=fibo-orchestra
S3_REGION=us-east-1

# Render Provider (bria, replicate, fal, runware)
RENDER_PROVIDER=bria
